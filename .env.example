# ---------------------------------------------------------------------------
# 로컬 개발: 이 파일을 .env 로 복사한 뒤 ANTHROPIC_API_KEY 만 채우면 된다.
#   cp .env.example .env
# .env 는 커밋하지 않는다 (.gitignore).
# ---------------------------------------------------------------------------

# [service] Claude API 키. 에이전트 루프가 모델을 호출할 때 쓴다.
ANTHROPIC_API_KEY=

# [service] 사용할 모델과 추론 노력 수준 (low | medium | high)
LLM_MODEL=claude-sonnet-5
LLM_EFFORT=medium

# [service] 포트 (Render 에서는 PORT 가 자동 주입되어 이 값보다 우선한다)
SERVICE_PORT=8787
# [mcp] 포트
MCP_PORT=8788

# [mcp] service 서버 주소. mcp 서버는 이 주소의 REST API 를 호출한다.
SERVICE_URL=http://localhost:8787

# [service] 에이전트가 붙을 MCP 서버 주소와 토큰 (MCP_TOKENS 중 propose 권한 토큰)
MCP_URL=http://localhost:8788/mcp
MCP_AGENT_TOKEN=dev-agent-token

# [mcp] 발급된 토큰 목록. "토큰:권한[:이름]" 을 쉼표로 구분한다.
#   read    = 조회 도구만 (외주 개발자용)
#   propose = 조회 + 티켓 작성 + 정책 변경안 제안 (정책 에이전트용)
# 운영에서는 반드시 긴 난수로 바꾼다. 예: openssl rand -hex 24
MCP_TOKENS=dev-read-token:read:외주개발자,dev-agent-token:propose:policy-agent

# [mcp] 도구 description 버전 (v1 = 대충 쓴 설명, v2 = 언제/언제 아님/반환 형식). 발표 실험용
TOOL_DESCRIPTIONS=v2

# [service] 파일 저장소 위치 (기본: 저장소 루트의 data/)
# DATA_DIR=./data
